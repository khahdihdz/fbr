      "expectedResolvedBy": "shortlink"
    },
    {
      "name": "share/r",
      "input": "https://www.facebook.com/share/r/16AbCdEfGh/",
      "expectedId": "share:r:16AbCdEfGh",
      "expectedKind": "short_link",
      "expectedResolvedBy": "shortlink"
    },
    {
      "name": "link nằm trong câu văn",
