{
  "_comment": "Fixture URL Facebook dùng chung cho các bài test. Không hardcode URL trong test.",
  "cases": [
    {
      "name": "watch cơ bản",
      "input": "https://www.facebook.com/watch/?v=1234567890123456",
      "expectedId": "1234567890123456",
      "expectedKind": "watch",
      "expectedResolvedBy": "url"
    },
    {
      "name": "watch có tham số tracking",
      "input": "https://www.facebook.com/watch/?v=1234567890123456&ref=share&mibextid=wwXIfr&__cft__[0]=abc",
      "expectedId": "1234567890123456",
      "expectedKind": "watch",
      "expectedResolvedBy": "url"
    },
    {
      "name": "web.facebook + video.php",
      "input": "https://web.facebook.com/video.php?v=9876543210987654",
      "expectedId": "9876543210987654",
      "expectedKind": "watch",
      "expectedResolvedBy": "url"
    },
    {
      "name": "story.php với story_fbid",
      "input": "https://m.facebook.com/story.php?story_fbid=1111222233334444&id=555666777",
      "expectedId": "1111222233334444",
      "expectedKind": "video",
      "expectedResolvedBy": "url"
    },
    {
      "name": "permalink.php với story_fbid",
      "input": "https://www.facebook.com/permalink.php?story_fbid=4444555566667777&id=1",
      "expectedId": "4444555566667777",
      "expectedKind": "video",
      "expectedResolvedBy": "url"
    },
    {
      "name": "đường dẫn /videos/ của page",
      "input": "https://www.facebook.com/somepage/videos/1234567890/",
      "expectedId": "1234567890",
      "expectedKind": "video",
      "expectedResolvedBy": "url"
    },
    {
      "name": "reel",
      "input": "https://www.facebook.com/reel/1234567890123456/",
      "expectedId": "1234567890123456",
      "expectedKind": "reel",
      "expectedResolvedBy": "url"
    },
    {
      "name": "reels có query",
      "input": "https://www.facebook.com/reels/9876543210987654?ref=reels",
      "expectedId": "9876543210987654",
      "expectedKind": "reel",
      "expectedResolvedBy": "url"
    },
    {
      "name": "link rút gọn fb.watch",
      "input": "https://fb.watch/abcDEF123/",
