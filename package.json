{
  "name": "fbr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Web app theo doi tien trinh xem video Facebook, du lieu chi luu tren may nguoi dung.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && vite build && node scripts/gen-precache.mjs",
    "preview": "vite preview --port 4173",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "fake-indexeddb": "^6.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
